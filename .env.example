# Public links wired into the CTA buttons. Leave empty to keep in-page anchors.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
VITE_CHROME_STORE_URL=https://chromewebstore.google.com/detail/jncjhnnikcigmhmlikpfbjnnflfbadbo
VITE_DOCS_URL=
# Live sale app for /raise. Leave empty until the round is cleared to open.
VITE_RAISE_URL=
# GAMI contract on Base (0x + 40 hex). Leave empty until the token is deployed and the address is
# announced on official channels; copy it from your own deploy output, never from a third party.
VITE_GAMI_TOKEN_ADDRESS=
# POST endpoint that accepts a gami.partner/1 manifest. Leave empty to fall back to email.
VITE_PARTNERS_API_URL=
# Privy app ID for wallet login and card / ramp funding on /raise. Public. Enable the funding providers in the Privy dashboard.
VITE_PRIVY_APP_ID=
