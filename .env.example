# Public links wired into the CTA buttons. Leave empty to keep in-page anchors.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
VITE_TESTFLIGHT_URL=https://testflight.apple.com/join/C8yYkmFr
VITE_CHROME_STORE_URL=https://chromewebstore.google.com/detail/gami/jncjhnnikcigmhmlikpfbjnnflfbadbo
VITE_DOCS_URL=
# Live sale app for /raise. Leave empty until the round is cleared to open.
VITE_RAISE_URL=
# GAMI contract on Base (0x + 40 hex). Leave empty until the token is deployed and the address is
# announced on official channels; copy it from your own deploy output, never from a third party.
VITE_GAMI_TOKEN_ADDRESS=
# POST endpoint that accepts a gami.partner/1 manifest. Leave empty to fall back to email.
VITE_PARTNERS_API_URL=
# Privy app ID for wallet login and card / ramp funding on /raise. Public. Enable the funding providers in the Privy dashboard.
VITE_PRIVY_APP_ID=
# Chain the GAMI contract lives on. Only "base" is supported; anything else keeps the page pre-launch.
VITE_GAMI_TOKEN_CHAIN=base
# Uniswap v3 seed, same names and units as script/SeedUniswapMainnet.s.sol: WHOLE tokens, WHOLE USDC.
# Opening price = SEED_USDC_UNITS / SEED_GAMI_WHOLE. Defaults are the runbook rehearsal (10,000,000 + 100,000 = $0.01).
VITE_SEED_GAMI_WHOLE=
VITE_SEED_USDC_UNITS=
# Hostnames. The raise page is served at the root of VITE_RAISE_SITE_URL and at /raise on the main site.
VITE_MAIN_SITE_URL=https://gamiprotocol.io
VITE_RAISE_SITE_URL=https://raise.gamiprotocol.io
